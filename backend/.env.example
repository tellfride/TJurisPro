# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jurispro
DB_USER=jurispro
DB_PASSWORD=troque-esta-senha

# Autenticação
JWT_SECRET=troque-este-segredo-por-uma-string-longa-e-aleatoria
JWT_EXPIRE_HOURS=8

# Caminho do executável mysqldump (deixe apenas "mysqldump" se estiver no PATH)
MYSQLDUMP_PATH=mysqldump

# Pasta onde os backups diários serão salvos (relativa ao backend/ ou absoluta)
BACKUP_DIR=../backups

# Quantos backups diários manter (os mais antigos são apagados)
BACKUP_RETENTION_DAYS=30

# Primeiro usuário Administrador, criado pelo script seed.py
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@jurispro.local
ADMIN_PASSWORD=troque-esta-senha
